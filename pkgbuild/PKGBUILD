pkgname=holophonor
pkgver=0.1.0
pkgrel=1
pkgdesc='Breathe into an EWI and paint with sound'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'libpipewire' 'alsa-lib')
optdepends=('noto-fonts: Noto Serif Display for titles'
            'noto-fonts-cjk: the character on the performer'"'"'s seal'
            'ttf-ia-writer: iA Writer Mono for the small type')
makedepends=('gcc' 'make' 'pkgconf')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/holophonor "$pkgdir/usr/bin/holophonor"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/holophonor.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/holophonor.svg"
  install -Dm644 "$startdir/holophonor.desktop" "$pkgdir/usr/share/applications/holophonor.desktop"
}
